---
import { Image } from 'astro:assets';
import SectionHead from '../ui/SectionHead.astro';
import { work } from '../../data/site.js';
import { img } from '../../data/images.js';
---
<section class="work section wrap" id="work">
  <SectionHead index="003" label="Selected work" aside="2019 to now" />
  <div class="intro grid-12">
    <h2 class="sec-title display" data-reveal>Work that<br /><span class="serif">moves</span> people</h2>
    <p class="mute">From fast-growing local favourites to global names, we partner with teams that want performance, not just visuals.</p>
  </div>

  <div class="work__grid">
    {work.map((w) => (
      <article class:list={['card', `card--${w.size}`]}>
        <div class="card__media">
          <Image src={img[w.img]} alt={`${w.title}: ${w.kind} by Attitude Design Studio`}
            widths={[480, 800, 1200]} sizes="(max-width: 900px) 100vw, 50vw" />
          <span class="card__pill label">{w.kind}</span>
        </div>
        <h3 class="card__t">{w.title}</h3>
      </article>
    ))}
  </div>
</section>

<style>
  .work { padding-top: var(--s-6); }
  .work__grid {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--s-5); row-gap: clamp(48px, 5vw, 64px); align-items: start;
  }
  /* editorial stagger (desktop) */
  .card:nth-child(1) { grid-column: 1 / span 7; }
  .card:nth-child(2) { grid-column: 9 / span 4; margin-top: clamp(64px, 10vw, 144px); }
  .card:nth-child(3) { grid-column: 1 / span 6; margin-top: calc(clamp(48px, 7vw, 96px) * -1); }
  .card:nth-child(4) { grid-column: 7 / span 3; }
  .card:nth-child(5) { grid-column: 10 / span 3; margin-top: clamp(48px, 7vw, 96px); }

  .card__media { position: relative; border-radius: var(--radius); overflow: hidden; background: var(--ink-3); }
  .card--wide .card__media { aspect-ratio: 16 / 10; }
  .card--tall .card__media { aspect-ratio: 4 / 5; }
  .card__media :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    filter: grayscale(1) contrast(1.08);
    transition: transform 1s var(--ease), filter .8s var(--ease);
  }
  /* desktop: colour on hover · touch: colour when the card is in view (class set in JS) */
  @media (hover: hover) { .card:hover .card__media :global(img) { filter: none; transform: scale(1.03); } }
  .card:global(.is-active) .card__media :global(img) { filter: none; }

  .card__pill {
    position: absolute; left: var(--s-4); top: var(--s-4);
    padding: 7px 12px; border-radius: 999px;
    background: rgba(12,12,11,.45); border: 1px solid rgba(251,250,247,.22);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  .card__t {
    margin-top: var(--s-4);
    font-family: var(--f-display); font-weight: 400; font-variation-settings: 'wdth' 100;
    font-size: clamp(1.3rem, 2.2vw, 2.1rem); letter-spacing: -0.035em; text-transform: uppercase; line-height: 1;
  }

  @media (max-width: 900px) {
    .work__grid { grid-template-columns: 1fr 1fr; column-gap: var(--s-4); }
    .card:nth-child(n) { grid-column: auto; margin-top: 0; }
    .card.card--wide, .card:nth-child(2) { grid-column: 1 / -1; }
    .card:nth-child(2) .card__media { aspect-ratio: 4 / 3; }
  }
  @media (max-width: 420px) {
    .card__pill { left: var(--s-3); top: var(--s-3); padding: 5px 9px; font-size: 10px; }
  }
</style>
