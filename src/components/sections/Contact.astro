---
import Button from '../ui/Button.astro';
import { BOOKING_URL, EMAIL, socials } from '../../data/site.js';
---
<section class="cta section wrap" id="contact">
  <span class="label mute">/006 Let’s talk</span>
  <h2 class="cta__title display" data-reveal>
    <span class="mask"><span>Book a</span></span>
    <span class="mask"><span><span class="serif">discovery</span> call</span></span>
  </h2>
  <div class="cta__row">
    <p class="cta__p mute">Let’s talk strategy, align expectations, and build a proposal tailored to your business needs and budget.</p>
    <div class="cta__actions">
      <Button href={BOOKING_URL} size="lg">Book here</Button>
      {EMAIL && <a href={`mailto:${EMAIL}`} class="link-u cta__mail">{EMAIL}</a>}
    </div>
  </div>
  <ul class="social" aria-label="Follow Attitude Design Studio">
    {socials.map((s) => (
      <li>
        <a href={s.href} target="_blank" rel="noopener" class="social__a">
          <span class="label mute">{s.label}</span>
          <span class="social__h">{s.handle}</span>
          <span class="social__arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .cta { padding-bottom: var(--s-9); }
  .cta__title { font-size: clamp(3rem, 11.5vw, 14.5rem); margin-top: var(--s-6); display: flex; flex-direction: column; }
  .cta__title > .mask:last-child { align-self: flex-end; }
  .cta__title .mask { padding-bottom: 0.16em; margin-bottom: -0.16em; }
  .cta__row { display: flex; justify-content: space-between; align-items: end; gap: var(--s-6); margin-top: var(--s-8); flex-wrap: wrap; }
  .cta__p { max-width: 40ch; font-size: var(--t-md); line-height: 1.45; }
  .cta__actions { display: flex; align-items: center; gap: var(--s-6); flex-wrap: wrap; }
  .cta__mail { font-size: var(--t-md); }
  .social { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); margin-top: var(--s-8); border-top: 1px solid var(--line-d); }
  .social li + li { border-left: 1px solid var(--line-d); }
  .social__a {
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: end; gap: var(--s-2) var(--s-4);
    padding: var(--s-5) var(--s-5) var(--s-5) 0;
  }
  .social li + li .social__a { padding-left: var(--s-5); padding-right: 0; }
  .social__a .label { grid-column: 1 / -1; }
  .social__h {
    font-family: var(--f-display); font-weight: 400; font-variation-settings: 'wdth' 100;
    font-size: clamp(1.25rem, 2.6vw, 2.5rem); line-height: 1; letter-spacing: -0.04em;
    overflow: hidden; text-overflow: ellipsis; white-space: nowrap; transition: color .3s;
  }
  .social__arrow { font-size: clamp(1.25rem, 2.4vw, 2.25rem); line-height: 1; transition: transform .5s var(--ease); }
  @media (hover: hover) {
    .social:hover .social__h { color: var(--mute-d); }
    .social__a:hover .social__h { color: var(--white); }
    .social__a:hover .social__arrow { transform: translate(4px, -4px); }
  }
  @media (max-width: 600px) {
    .social { grid-template-columns: minmax(0, 1fr); }
    .social li + li { border-left: 0; border-top: 1px solid var(--line-d); }
    .social__a, .social li + li .social__a { padding: var(--s-5) 0; }
  }
  @media (max-width: 560px) {
    .cta__title > .mask:last-child { align-self: flex-start; }
    .cta__row { margin-top: var(--s-7); }
  }
</style>
