---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { img } from '../../data/images.js';
import { BOOKING_URL } from '../../data/site.js';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <!-- motion blur is pre-rendered into the file, so it looks identical on every browser -->
    <Image src={img.heroMotion} alt="" class="hero__img" loading="eager" fetchpriority="high"
      widths={[800, 1200, 1800]} sizes="100vw" />
  </div>
  <div class="hero__veil" aria-hidden="true"></div>

  <div class="hero__meta wrap label">
    <span>Creative Department®</span>
    <span class="hide-sm">Company Profile &amp; Services</span>
    <span>Est. 2019</span>
  </div>

  <h1 id="hero-title" class="hero__title display wrap">
    <span class="sr-only">Hi, we’re a creative agency!</span>
    <span class="row r1" aria-hidden="true">
      <span class="mask"><span>Hi,</span></span>
      <span class="pill pill--a hide-sm"><Image src={img.introCafe} alt="" loading="eager" widths={[320, 640]} sizes="24vw" /></span>
      <span class="mask"><span>we’re a</span></span>
    </span>
    <span class="row r2" aria-hidden="true">
      <span class="mask"><span>creative</span></span>
      <span class="pill pill--b"><Image src={img.introFood} alt="" loading="eager" widths={[240, 480]} sizes="18vw" /></span>
    </span>
    <span class="row r3" aria-hidden="true">
      <span class="pill pill--c hide-sm"><Image src={img.introCocktail} alt="" loading="eager" widths={[200, 400]} sizes="15vw" /></span>
      <span class="mask"><span>agency!</span></span>
    </span>
  </h1>

  <div class="hero__foot wrap">
    <p class="hero__lede" data-enter>
      Creative &amp; digital marketing since 2019. We combine creativity and strategy to build brands that
      <span class="serif">stand out</span> and drive real business growth.
    </p>
    <div class="hero__card" data-enter>
      <div class="hero__card-img"><Image src={img.founder} alt="" loading="eager" width={112} /></div>
      <div>
        <p class="label mute">Trusted by</p>
        <p class="hero__card-t">DJI, Din Tai Fung, Falken &amp; 40+ brands</p>
      </div>
    </div>
    <div class="hero__actions" data-enter>
      <Button href={BOOKING_URL}>Book a discovery call</Button>
      <Button href="#services" variant="ghost" arrow={false}>Our services</Button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: 100vh; min-height: 100svh;
    display: grid; grid-template-rows: auto 1fr auto; grid-template-columns: minmax(0, 1fr);
    padding-top: 92px; padding-bottom: var(--s-6);
    background: var(--ink);
  }
  .hero__bg { position: absolute; inset: 0; z-index: -2; }
  .hero__bg :global(.hero__img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 45%; transform: scale(1.08); }
  .hero__veil {
    position: absolute; inset: 0; z-index: -1;
    background:
      linear-gradient(180deg, rgba(12,12,11,.72) 0%, rgba(12,12,11,.12) 28%, rgba(12,12,11,.12) 55%, rgba(12,12,11,.92) 100%),
      radial-gradient(120% 80% at 50% 40%, transparent 35%, rgba(12,12,11,.75) 100%);
  }
  .hero__meta { display: flex; justify-content: space-between; gap: var(--s-4); color: rgba(251,250,247,.75); }

  /* Headline: scales with width, but never taller than the viewport allows (landscape phones). */
  .hero__title {
    align-self: center;
    display: flex; flex-direction: column;
    font-size: clamp(2.8rem, min(10.6vw, 21svh), 13.5rem);
    padding-block: var(--s-7);
  }
  .row { display: flex; align-items: center; gap: 0.18em; }
  .r2 { padding-left: 0.9em; }
  .r3 { justify-content: flex-end; }
  .pill {
    display: inline-block; flex: none;
    height: 0.74em; width: var(--w, 2.1em);
    border-radius: 0.12em; overflow: hidden;
    transform: translateY(0.02em);
    transition: width 1.3s var(--ease);
  }
  .pill :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.1); transition: filter .6s var(--ease); }
  .pill:hover :global(img) { filter: none; }
  .pill--b { --w: 1.6em; }
  .pill--c { --w: 1.3em; }

  .hero__foot { display: grid; grid-template-columns: minmax(0, 1.1fr) auto minmax(0, 1fr); align-items: end; gap: var(--s-6); }
  .hero__lede { max-width: 34ch; font-size: var(--t-md); line-height: 1.45; letter-spacing: -0.01em; color: rgba(251,250,247,.86); }
  .hero__lede .serif { font-size: 1.15em; color: var(--white); }
  .hero__card {
    display: flex; align-items: center; gap: var(--s-4); max-width: 340px;
    padding: var(--s-3) var(--s-5) var(--s-3) var(--s-3);
    border-radius: var(--radius); border: 1px solid rgba(251,250,247,.14);
    background: rgba(251,250,247,.07);
    -webkit-backdrop-filter: blur(18px) saturate(1.2); backdrop-filter: blur(18px) saturate(1.2);
  }
  .hero__card-img { width: 56px; height: 56px; flex: none; border-radius: 12px; overflow: hidden; }
  .hero__card-img :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 15%; filter: grayscale(1); }
  .hero__card-t { font-size: var(--t-sm); line-height: 1.35; margin-top: 2px; }
  .hero__actions { justify-self: end; display: flex; gap: var(--s-3); flex-wrap: wrap; justify-content: flex-end; }

  @media (max-width: 1100px) {
    .hero__foot { grid-template-columns: 1fr auto; }
    .hero__card { display: none; }
  }
  /* portrait tablets: bigger type, drop the first inline image so line 1 still fits */
  @media (max-width: 1100px) and (orientation: portrait) {
    .hero__title { font-size: min(12.6vw, 17svh); }
    .pill--a { display: none; }
    .r2 { padding-left: 0; }
    .pill--b { --w: 1.2em; }
  }
  @media (max-width: 680px) {
    .hide-sm { display: none !important; }
    .hero { padding-top: 84px; }
    .hero__title { font-size: min(14.6vw, 16svh); padding-block: var(--s-6); }
    .r2 { padding-left: 0; }
    .pill--b { --w: 1.05em; }
    .hero__foot { grid-template-columns: 1fr; gap: var(--s-5); }
    .hero__actions { justify-self: stretch; justify-content: flex-start; }
  }
  /* short landscape screens: compact the foot */
  @media (max-height: 520px) and (orientation: landscape) {
    .hero__lede { display: none; }
    .hero__foot { grid-template-columns: 1fr; }
    .hero__actions { justify-self: start; }
  }

  /* entrance initial state (only when JS is running) */
  :global(.js) .hero:not(.is-in) .pill { width: 0; }
  :global(.js) .hero .mask > span { transform: translateY(105%); }
  :global(.js) .hero [data-enter], :global(.js) .hero__meta { opacity: 0; }
  :global(.js) .hero [data-enter] { transform: translateY(16px); }
  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero:not(.is-in) .pill { width: var(--w, 2.1em); }
    :global(.js) .hero .mask > span, :global(.js) .hero [data-enter] { transform: none; }
    :global(.js) .hero [data-enter], :global(.js) .hero__meta { opacity: 1; }
  }
</style>
