---
import SectionHead from '../ui/SectionHead.astro';
import { services, additionalServices, BOOKING_URL } from '../../data/site.js';

const pad = (n) => String(n).padStart(2, '0');
---
<section class="services section wrap" id="services">
  <SectionHead index="002" label="Services" aside="Everything under one roof" />
  <h2 class="sec-title display" data-reveal>What we <span class="serif">do</span></h2>

  <ol class="svc">
    {services.map((s, i) => (
      <li class="svc__item">
        <details>
          <summary class="svc__row">
            <span class="svc__n label">{pad(i + 1)}</span>
            <span class="svc__t">{s.title}</span>
            <span class="svc__tag label mute">{s.tag}</span>
            <span class="svc__plus" aria-hidden="true"></span>
          </summary>
          <div class="svc__body">
            <p>{s.body}</p>
            <a href={BOOKING_URL} class="svc__price link-u label">Pricing on request →</a>
          </div>
        </details>
      </li>
    ))}
    <!-- 07: add-ons that sit on top of any retainer -->
    <li class="svc__item" id="additional">
      <details>
        <summary class="svc__row">
          <span class="svc__n label">{pad(services.length + 1)}</span>
          <span class="svc__t">Additional Services</span>
          <span class="svc__tag label mute">Add to any retainer</span>
          <span class="svc__plus" aria-hidden="true"></span>
        </summary>
        <div class="svc__body">
          <div class="svc__subs">
            {additionalServices.map((a, i) => (
              <div class="svc__sub">
                <div class="svc__sub-top">
                  <span class="label mute">{pad(services.length + 1)}.{i + 1}</span>
                  <span class="label mute">{a.tag}</span>
                </div>
                <h3 class="svc__sub-t">{a.title}</h3>
                <p>{a.body}</p>
              </div>
            ))}
          </div>
          <a href={BOOKING_URL} class="svc__price link-u label">Ask about it →</a>
        </div>
      </details>
    </li>
  </ol>
</section>

<style>
  .services { position: relative; }
  .sec-title { margin-bottom: clamp(48px, 5vw, 64px); }
  .svc { border-top: 1px solid var(--line-d); }
  .svc__item { border-bottom: 1px solid var(--line-d); }
  summary { list-style: none; }
  summary::-webkit-details-marker { display: none; }
  .svc__row {
    display: grid; grid-template-columns: 64px minmax(0, 1fr) auto 40px; align-items: center; gap: var(--s-5);
    padding-block: clamp(20px, 2.4vw, 32px); cursor: pointer;
  }
  .svc__t {
    font-family: var(--f-display); font-weight: 400; font-variation-settings: 'wdth' 100;
    font-size: clamp(1.45rem, 3.6vw, 3.4rem); line-height: 1; letter-spacing: -0.04em; text-transform: uppercase;
    text-wrap: balance;
    transition: transform .6s var(--ease), color .3s;
  }
  .svc__n { color: var(--mute-d); }
  .svc__plus { position: relative; width: 22px; height: 22px; justify-self: end; }
  .svc__plus::before, .svc__plus::after {
    content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: currentColor;
    transition: transform .5s var(--ease);
  }
  .svc__plus::after { transform: rotate(90deg); }
  details[open] .svc__plus::after { transform: rotate(0deg); }
  @media (hover: hover) {
    .svc:hover .svc__t { color: var(--mute-d); }
    .svc .svc__item:hover .svc__t { color: var(--white); transform: translateX(14px); }
  }
  .svc__body { display: grid; grid-template-columns: 64px minmax(0, 1fr) auto; gap: var(--s-5); padding-bottom: var(--s-7); }
  .svc__body p { grid-column: 2; max-width: 58ch; color: rgba(251,250,247,.75); font-size: 1.0625rem; }
  .svc__price { grid-column: 3; align-self: end; white-space: nowrap; }
  details[open] .svc__body { animation: open .6s var(--ease); }
  @keyframes open { from { opacity: 0; transform: translateY(-8px); } }

  /* 07 Additional Services: two add-ons side by side inside the row */
  #additional { scroll-margin-top: 96px; }
  .svc__subs { grid-column: 2; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(24px, 3vw, 56px); }
  .svc__sub { display: flex; flex-direction: column; gap: var(--s-3); padding-top: var(--s-4); border-top: 1px solid var(--line-d); }
  .svc__sub-top { display: flex; justify-content: space-between; gap: var(--s-4); }
  .svc__sub-t {
    margin: var(--s-2) 0 0; font-family: var(--f-display); font-weight: 400; font-variation-settings: 'wdth' 100;
    font-size: clamp(1.3rem, 2vw, 1.9rem); line-height: 1; letter-spacing: -0.04em; text-transform: uppercase;
  }
  .svc__body .svc__sub p { grid-column: auto; max-width: 52ch; }
  @media (max-width: 760px) { .svc__subs { grid-template-columns: minmax(0, 1fr); } }

  @media (max-width: 680px) {
    .svc__row { grid-template-columns: 28px minmax(0, 1fr) 22px; gap: var(--s-3); }
    .svc__tag { display: none; }
    .svc__body { grid-template-columns: 28px 1fr; gap: var(--s-3); }
    .svc__body p { font-size: 1rem; }
    .svc__price { grid-column: 2; justify-self: start; padding-block: var(--s-2); }
  }
</style>
