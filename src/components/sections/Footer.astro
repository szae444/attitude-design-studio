---
import Logo from '../Logo.astro';
import { nav, socials } from '../../data/site.js';
const year = new Date().getFullYear();
---
<footer class="foot wrap">
  <div class="foot__top">
    <p class="label mute">Creative Department®</p>
    <nav class="foot__nav" aria-label="Footer">
      {nav.map((l) => <a href={l.href} class="link-u">{l.label}</a>)}
      <a href="#contact" class="link-u">Contact</a>
      <span class="foot__sep" aria-hidden="true"></span>
      {socials.map((s) => <a href={s.href} target="_blank" rel="noopener" class="link-u">{s.label} ↗</a>)}
    </nav>
    <a href="#top" class="label link-u">Back to top ↑</a>
  </div>
  <Logo size="xl" class="foot__logo" />
  <div class="foot__bot label mute">
    <span>© {year} Attitude Design Studio. All rights reserved.</span>
    <span>Est. 2019</span>
  </div>
</footer>

<style>
  .foot { padding-top: var(--s-8); padding-bottom: var(--s-5); border-top: 1px solid var(--line-d); overflow: hidden; }
  .foot__top { display: flex; justify-content: space-between; align-items: center; gap: var(--s-5); flex-wrap: wrap; }
  .foot__nav { display: flex; gap: var(--s-2) var(--s-6); font-size: var(--t-sm); flex-wrap: wrap; }
  .foot__nav a { padding-block: var(--s-2); }
  .foot__sep { width: 1px; align-self: stretch; margin-block: 6px; background: var(--line-d); }
  @media (max-width: 600px) { .foot__sep { display: none; } }
  .foot :global(.foot__logo) { display: block; margin-block: clamp(56px, 7vw, 96px) var(--s-6); }
  .foot__bot { display: flex; justify-content: space-between; gap: var(--s-4); flex-wrap: wrap; padding-top: var(--s-4); border-top: 1px solid var(--line-d); }
</style>
