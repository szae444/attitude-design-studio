---
import { Image } from 'astro:assets';
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import { team, founder, BOOKING_URL } from '../../data/site.js';
import { img } from '../../data/images.js';

const photos = import.meta.glob('../../assets/team/*.jpg', { eager: true, import: 'default' });
const photo = (k) => k && photos[`../../assets/team/${k}.jpg`];
const initials = (n) => n.split(' ').filter((w) => /^[A-Z]/.test(w)).slice(0, 2).map((w) => w[0]).join('');
const pad = (n) => String(n).padStart(2, '0');
---
<section class="studio section wrap" id="studio">
  <SectionHead index="004" label="The studio" aside="Behind the brand" />

  <div class="founder grid-12">
    <figure class="founder__img">
      <Image src={img.founder} alt={`${founder.name}, ${founder.role}`} widths={[400, 800]} sizes="(max-width: 900px) 100vw, 40vw" />
    </figure>
    <div class="founder__txt">
      <h2 class="founder__name display" data-reveal>{founder.first}<br />{founder.last}</h2>
      <p class="label mute">{founder.role}</p>
      <p class="founder__bio">{founder.bio}</p>
    </div>
  </div>

  <div class="team-head intro grid-12">
    <h2 class="sec-title display" data-reveal>Meet the<br /><span class="serif">team</span></h2>
    <p class="mute">Strategists, writers, artists and account leads. Each team runs a maximum of three brands, so the people you meet here are the people doing the work.</p>
  </div>

  <ul class="crew">
    {team.map((m, i) => (
      <li class="member">
        <figure class="member__img">
          {photo(m.photo)
            ? <Image src={photo(m.photo)} alt={`${m.n}, ${m.r}`} widths={[320, 520]} sizes="(max-width: 600px) 50vw, (max-width: 1100px) 33vw, 20vw" />
            : <span class="member__mono" aria-hidden="true">{initials(m.n)}</span>}
          <span class="member__n label">{pad(i + 1)}</span>
        </figure>
        <h3 class="member__name">{m.n}</h3>
        <p class="label mute">{m.r}</p>
      </li>
    ))}
    <li class="crew__cta">
      <p class="label mute">/{pad(team.length + 1)}</p>
      <p class="crew__cta-t">Your brand,<br /><span class="serif">our team.</span></p>
      <Button href={BOOKING_URL} size="sm">Book a call</Button>
    </li>
  </ul>
</section>

<style>
  .founder { align-items: end; }
  .founder__img { grid-column: 1 / span 5; border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 5; }
  .founder__img :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; filter: grayscale(1) contrast(1.08); }
  .founder__txt { grid-column: 7 / span 6; display: grid; gap: var(--s-5); }
  .founder__name { font-size: var(--t-2xl); }
  .founder__bio { font-size: var(--t-md); line-height: 1.5; color: rgba(251,250,247,.78); max-width: 46ch; letter-spacing: -0.01em; }

  .team-head { margin-top: clamp(112px, 12vw, 176px); }

  /* 14 people + 1 CTA tile = 15 → 5 / 3 columns divide evenly; 2 columns let the CTA span */
  .crew {
    display: grid; grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(32px, 3.4vw, 48px) clamp(12px, 1.4vw, 20px);
    border-top: 1px solid var(--line-d); padding-top: clamp(24px, 2.4vw, 32px);
  }
  .member { display: grid; gap: 6px; align-content: start; }
  .member__img {
    position: relative; aspect-ratio: 4 / 5; margin-bottom: var(--s-3);
    border-radius: var(--radius); overflow: hidden; background: var(--ink-3);
  }
  .member__img :global(img) {
    width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%;
    filter: grayscale(1) contrast(1.06);
    transition: transform 1s var(--ease);
  }
  @media (hover: hover) { .member:hover .member__img :global(img) { transform: scale(1.04); } }
  .member__mono {
    position: absolute; inset: 0; display: grid; place-items: center;
    font-family: var(--f-serif); font-style: italic; font-size: clamp(3rem, 6vw, 5.5rem); color: var(--mute-d);
    background: radial-gradient(90% 70% at 50% 35%, var(--ink-3), var(--ink-2));
  }
  .member__n {
    position: absolute; left: var(--s-3); top: var(--s-3);
    padding: 5px 9px; border-radius: 999px;
    background: rgba(12,12,11,.45); border: 1px solid rgba(251,250,247,.2);
    -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
  }
  .member__name {
    font-family: var(--f-display); font-weight: 500; font-variation-settings: 'wdth' 100;
    font-size: clamp(1rem, 1.25vw, 1.25rem); line-height: 1.1; letter-spacing: -0.025em; text-transform: uppercase;
  }

  .crew__cta {
    display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; gap: var(--s-6);
    aspect-ratio: 4 / 5; padding: var(--s-5);
    border-radius: var(--radius); border: 1px solid var(--line-d);
  }
  .crew__cta-t {
    font-family: var(--f-display); font-weight: 300; font-variation-settings: 'wdth' 106;
    font-size: clamp(1.6rem, 2.4vw, 2.4rem); line-height: 0.95; letter-spacing: -0.04em; text-transform: uppercase;
  }

  @media (max-width: 1100px) { .crew { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) {
    .founder__img, .founder__txt { grid-column: 1 / -1; }
    .founder__img { aspect-ratio: 4 / 4.4; max-height: 80svh; }
  }
  @media (max-width: 600px) {
    .crew { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .crew__cta { grid-column: 1 / -1; aspect-ratio: auto; min-height: 200px; }
    .member__n { left: var(--s-2); top: var(--s-2); font-size: 10px; padding: 4px 7px; }
  }
</style>
