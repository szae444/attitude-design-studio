---
import { Image } from 'astro:assets';
import SectionHead from '../ui/SectionHead.astro';
import { partners, creatives, founder } from '../../data/site.js';
import { img } from '../../data/images.js';
---
<section class="studio section wrap" id="studio">
  <SectionHead index="005" label="The studio" aside="Behind the brand" />

  <div class="founder grid-12">
    <figure class="founder__img">
      <Image src={img.founder} alt={`${founder.name}, ${founder.role}`} widths={[400, 800]} sizes="(max-width: 900px) 100vw, 40vw" />
    </figure>
    <div class="founder__txt">
      <h2 class="founder__name display" data-reveal>{founder.first}<br />{founder.last}</h2>
      <p class="label mute">{founder.role}</p>
      <p class="founder__bio">{founder.bio}</p>
    </div>
  </div>

  <div class="team grid-12">
    <figure class="team__img">
      <Image src={img.team} alt="The Attitude Design Studio creative team" widths={[480, 900]} sizes="(max-width: 900px) 100vw, 40vw" />
    </figure>
    <div class="team__lists">
      {[{ h: 'Partners & Operations', list: partners }, { h: 'Creative & Content', list: creatives }].map((g) => (
        <div>
          <h3 class="label mute team__h">{g.h}</h3>
          <ul>{g.list.map((p) => <li><span>{p.n}</span><span class="label mute">{p.r}</span></li>)}</ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .founder { align-items: end; }
  .founder__img { grid-column: 1 / span 5; border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 5; }
  .founder__img :global(img), .team__img :global(img) { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.08); }
  .founder__img :global(img) { object-position: 50% 20%; }
  .founder__txt { grid-column: 7 / span 6; display: grid; gap: var(--s-5); }
  .founder__name { font-size: var(--t-2xl); }
  .founder__bio { font-size: var(--t-md); line-height: 1.5; color: rgba(251,250,247,.78); max-width: 46ch; letter-spacing: -0.01em; }

  .team { margin-top: clamp(96px, 10vw, 144px); }
  .team__img { grid-column: 1 / span 5; border-radius: var(--radius); overflow: hidden; aspect-ratio: 1; align-self: start; position: sticky; top: 100px; }
  .team__img :global(img) { object-position: 50% 30%; }
  .team__lists { grid-column: 7 / span 6; display: grid; gap: var(--s-8); }
  .team__h { padding-bottom: var(--s-3); border-bottom: 1px solid var(--line-d); font-weight: 400; }
  .team__lists li {
    display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-4);
    padding-block: var(--s-3); border-bottom: 1px solid var(--line-d);
    font-size: var(--t-md); letter-spacing: -0.015em;
    transition: padding .4s var(--ease);
  }
  @media (hover: hover) { .team__lists li:hover { padding-left: var(--s-3); } }
  .team__lists li .label { text-align: right; }

  @media (max-width: 900px) {
    .founder__img, .founder__txt, .team__img, .team__lists { grid-column: 1 / -1; }
    .founder__img { aspect-ratio: 4 / 4.4; max-height: 80svh; }
    .team__img { position: static; aspect-ratio: 4 / 3; }
  }
  @media (max-width: 560px) {
    .team__lists li { flex-direction: column; gap: 2px; }
    .team__lists li .label { text-align: left; }
  }
</style>
