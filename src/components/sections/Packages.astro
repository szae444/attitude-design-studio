---
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import { packages, packageCore, BOOKING_URL } from '../../data/site.js';
---
<section class="packages section light wrap" id="packages">
  <SectionHead index="004" label="Packages" aside="Monthly retainers" />
  <div class="intro grid-12">
    <h2 class="sec-title display" data-reveal>Pick your<br /><span class="serif">pace</span></h2>
    <p class="mute">Every package comes with a strategy plan, production, a dedicated team and a monthly report. Pricing is tailored to your brand, so let’s talk.</p>
  </div>

  <div class="pkg">
    {packages.map((p) => (
      <article class:list={['pkg__col', p.featured && 'is-featured']}>
        <header class="pkg__head">
          <h3 class="pkg__name">{p.name}<br /><span>Package</span></h3>
          {p.featured && <span class="pkg__badge label">Most chosen</span>}
          <p class="label pkg__for">{p.for}</p>
        </header>
        <ul class="pkg__list">{p.items.map((it) => <li>{it}</li>)}</ul>
        <ul class="pkg__core label">{packageCore.map((it) => <li>— {it}</li>)}</ul>
        <div class="pkg__foot">
          <div>
            <p class="label pkg__muted">Investment</p>
            <p class="pkg__price">On request</p>
          </div>
          <Button href={BOOKING_URL} variant={p.featured ? 'solid' : 'dark'}>Get a quote</Button>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .pkg { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line-l); }
  .pkg__col {
    display: flex; flex-direction: column; gap: var(--s-6);
    padding: var(--s-6); border-right: 1px solid var(--line-l);
  }
  .pkg__col:first-child { padding-left: 0; }
  .pkg__col:last-child { border-right: 0; padding-right: 0; }
  .pkg__col.is-featured {
    background: var(--ink); color: var(--white); border-radius: var(--radius); border-right: 0;
    padding: var(--s-6); margin-block: calc(var(--s-5) * -1);
  }
  .is-featured .pkg__list li { border-color: var(--line-d); }
  .is-featured .pkg__core, .is-featured .pkg__muted, .is-featured .pkg__for { color: var(--mute-d); }

  .pkg__head { display: grid; grid-template-columns: 1fr auto; align-items: start; gap: 0 var(--s-3); }
  .pkg__name {
    font-family: var(--f-display); font-weight: 500; font-variation-settings: 'wdth' 100;
    font-size: clamp(2rem, 3.4vw, 3.25rem); line-height: 0.92; letter-spacing: -0.045em; text-transform: uppercase;
  }
  .pkg__name span { font-weight: 300; }
  .pkg__badge { padding: 6px 10px; border-radius: 999px; border: 1px solid var(--line-d); white-space: nowrap; }
  .pkg__for { grid-column: 1 / -1; margin-top: var(--s-3); color: var(--mute-l); }
  .pkg__list li { padding-block: var(--s-3); border-bottom: 1px solid var(--line-l); font-size: 1.0625rem; letter-spacing: -0.01em; }
  .pkg__core { display: grid; gap: var(--s-2); color: var(--mute-l); }
  .pkg__foot { margin-top: auto; display: flex; justify-content: space-between; align-items: end; gap: var(--s-4); flex-wrap: wrap; padding-top: var(--s-5); }
  .pkg__muted { color: var(--mute-l); }
  .pkg__price { font-family: var(--f-serif); font-style: italic; font-size: 2rem; line-height: 1.1; }

  /* tablet: featured on top full-width, other two side by side */
  @media (max-width: 1100px) {
    .pkg { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-5); border-top: 0; }
    .pkg__col, .pkg__col:first-child, .pkg__col:last-child { padding: var(--s-6) 0 0; border-right: 0; border-top: 1px solid var(--line-l); }
    .pkg__col.is-featured { grid-column: 1 / -1; order: -1; margin: 0; padding: var(--s-6); border-top: 0; }
  }
  @media (max-width: 680px) {
    .pkg { grid-template-columns: minmax(0, 1fr); gap: var(--s-6); }
    .pkg__col { min-width: 0; }
    .pkg__col.is-featured { padding: var(--s-5); }
    .pkg__head { grid-template-columns: minmax(0, 1fr); }
    .pkg__badge { grid-row: 1; justify-self: start; margin-bottom: var(--s-3); }
  }
</style>
