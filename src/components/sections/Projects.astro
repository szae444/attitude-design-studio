---
/**
 * Projects: a normal-height section (no scroll pinning) so the page scrolls straight past it.
 * The moving wall is only a preview; visitors who want the work open the full grid
 * (one cover per client) with "View projects". Open/close logic: scripts/modules/projects.js.
 */
import { Image } from 'astro:assets';
import SectionHead from '../ui/SectionHead.astro';
import Button from '../ui/Button.astro';
import Arrow from '../ui/Arrow.astro';
import Mosaic from '../ui/Mosaic.astro';
import { projects } from '../../data/projects.js';

const files = import.meta.glob('../../assets/projects/*/*.jpg', { eager: true });
const photo = (slug, n) => files[`../../assets/projects/${slug}/${String(n).padStart(2, '0')}.jpg`].default;
const pad = (n) => String(n).padStart(2, '0');
const total = projects.reduce((a, p) => a + p.count, 0);
---
<section class="pj light section wrap" id="projects" aria-label="Selected projects">
  <SectionHead index="005" label="Projects" aside={`${projects.length} brands · ${total} frames`} />

  <div class="pj__head">
    <h2 class="sec-title display" data-reveal>Selected <span class="serif">projects</span></h2>
    <div class="pj__intro">
      <p class="pj__lede mute">Shoots, content and campaigns we’ve produced for brands across food, hospitality, wellness and lifestyle.</p>
      <button type="button" class="btn btn--dark pj__open" data-pj-open aria-haspopup="dialog" aria-controls="pj-all">
        View projects
        <span class="btn__dot"><Arrow /></span>
      </button>
    </div>
  </div>

  <!-- preview: moves on its own, never takes over the page scroll -->
  <button type="button" class="pj__preview" data-pj-open aria-haspopup="dialog" aria-controls="pj-all" aria-label={`View all ${projects.length} projects`}>
    <Mosaic cols={7} class="pj__wall pj__wall--lg" sizes="(min-width: 901px) 15vw, 1px" />
    <Mosaic cols={3} class="pj__wall pj__wall--sm" sizes="(max-width: 900px) 33vw, 1px" />
    <span class="pj__chip label">View all {projects.length} projects</span>
  </button>
</section>

<!-- full grid, opened on request -->
<dialog class="pjx light" id="pj-all" aria-label="Selected projects" data-lenis-prevent>
  <div class="pjx__bar wrap">
    <span class="label">Selected projects <span class="mute">· {projects.length} brands</span></span>
    <button type="button" class="pjx__close label" data-pj-close>Close <span class="pjx__x" aria-hidden="true"></span></button>
  </div>

  <div class="pjx__body wrap">
    <h2 class="pjx__title display">Selected <span class="serif">projects</span></h2>
    <ul class="pjx__grid">
      {projects.map((p, i) => (
        <li class="pjx__item" style={`--i:${i}`}>
          <div class="pjx__frame">
            <Image src={photo(p.slug, p.cover)} alt={`${p.kind} shoot`} widths={[480, 720, 960, 1280]} sizes="(min-width: 1200px) 23vw, (min-width: 901px) 31vw, 46vw" quality={88} loading="lazy" style={p.pos && `object-position:${p.pos}`} />
          </div>
          <div class="pjx__foot">
            <span class="pjx__idx">/{pad(i + 1)}</span>
            <span class="label mute">{p.kind}</span>
          </div>
        </li>
      ))}
    </ul>

    <div class="pjx__end">
      <p class="pjx__end-t display">Your brand <span class="serif">next.</span></p>
      <Button href="#contact" variant="dark" data-pj-close>Start a project</Button>
    </div>
  </div>
</dialog>

<style>
  /* ───────── section ───────── */
  .pj { position: relative; }
  .pj__head { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: end; gap: var(--s-6); margin-bottom: clamp(36px, 4vw, 56px); }
  .pj__head .sec-title { margin: 0; line-height: .86; }
  .pj__intro { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-5); }
  .pj__lede { max-width: 38ch; font-size: var(--t-md); line-height: 1.45; }
  .pj__open { border: 0; font: inherit; cursor: pointer; }

  /* preview wall: a fixed-height window, faded top and bottom */
  .pj__preview {
    position: relative; display: block; width: 100%; padding: 0; border: 0; background: none; color: inherit; cursor: pointer;
    height: clamp(440px, 74vh, 780px); border-radius: var(--radius); overflow: hidden;
  }
  .pj__preview::before, .pj__preview::after { content: ''; position: absolute; left: 0; right: 0; height: 12%; z-index: 1; pointer-events: none; }
  .pj__preview::before { top: 0; background: linear-gradient(var(--paper), transparent); }
  .pj__preview::after { bottom: 0; background: linear-gradient(transparent, var(--paper)); }
  .pj__preview :global(.pj__wall) { height: 100%; }
  .pj__preview :global(.pj__wall--sm) { display: none; }
  .pj__chip {
    position: absolute; left: 50%; bottom: var(--s-5); z-index: 2; transform: translateX(-50%);
    padding: 14px 22px; border-radius: 999px; background: var(--ink); color: var(--white); white-space: nowrap;
    transition: transform .5s var(--ease);
  }
  .pj__preview:hover .pj__chip, .pj__preview:focus-visible .pj__chip { transform: translateX(-50%) translateY(-4px); }

  @media (max-width: 900px) {
    .pj__head { grid-template-columns: minmax(0, 1fr); gap: var(--s-5); }
    .pj__preview { height: min(128vw, 72svh); }
    .pj__preview :global(.pj__wall--lg) { display: none; }
    .pj__preview :global(.pj__wall--sm) { display: grid; }
  }

  /* ───────── full grid dialog ───────── */
  .pjx {
    position: fixed; inset: 0; z-index: 80; width: 100%; max-width: none; height: 100%; max-height: none;
    margin: 0; padding: 0; border: 0; overflow-y: auto; overscroll-behavior: contain;
    background: var(--paper); color: var(--ink);
  }
  .pjx::backdrop { background: rgba(12, 12, 11, .5); }
  .pjx[open] { animation: pjx-in .6s var(--ease); }
  @keyframes pjx-in { from { opacity: 0; transform: translateY(24px); } }

  .pjx__bar {
    position: sticky; top: 0; z-index: 2; display: flex; justify-content: space-between; align-items: center; gap: var(--s-4);
    padding-block: var(--s-4); background: var(--paper); border-bottom: 1px solid var(--line-l);
  }
  .pjx__close {
    display: inline-flex; align-items: center; gap: var(--s-3); height: 44px; padding: 0 var(--s-4) 0 var(--s-5);
    border: 1px solid var(--line-l); border-radius: 999px; background: none; color: inherit; cursor: pointer;
    transition: background-color .3s, color .3s;
  }
  .pjx__close:hover { background: var(--ink); color: var(--white); }
  .pjx__x { position: relative; width: 12px; height: 12px; }
  .pjx__x::before, .pjx__x::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: currentColor; transform: rotate(45deg); }
  .pjx__x::after { transform: rotate(-45deg); }

  .pjx__body { padding-block: clamp(32px, 5vw, 72px) clamp(48px, 6vw, 96px); }
  .pjx__title { font-size: clamp(2.6rem, 7vw, 6rem); line-height: .86; letter-spacing: -0.055em; margin-bottom: clamp(28px, 4vw, 56px); }
  .pjx__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(28px, 3vw, 48px) clamp(14px, 1.4vw, 24px); list-style: none; padding: 0; margin: 0; }
  .pjx__item { opacity: 0; transform: translateY(20px); }
  .pjx[open] .pjx__item { animation: pjx-item .8s var(--ease) forwards; animation-delay: calc(.15s + var(--i) * .04s); }
  @keyframes pjx-item { to { opacity: 1; transform: none; } }
  .pjx__frame { aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--radius); background: var(--paper-2); }
  .pjx__frame :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  @media (hover: hover) { .pjx__item:hover .pjx__frame :global(img) { transform: scale(1.04); } }
  .pjx__foot { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-3); padding-top: var(--s-3); }
  .pjx__idx { font-family: var(--f-display); font-weight: 300; font-size: clamp(1.5rem, 2vw, 2rem); line-height: 1; letter-spacing: -0.05em; }

  .pjx__end {
    display: flex; justify-content: space-between; align-items: center; gap: var(--s-5); flex-wrap: wrap;
    margin-top: clamp(48px, 6vw, 96px); padding-top: var(--s-6); border-top: 1px solid var(--line-l);
  }
  .pjx__end-t { font-size: clamp(2.2rem, 5vw, 4.4rem); line-height: .9; letter-spacing: -0.055em; }

  @media (max-width: 1199px) { .pjx__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 900px) { .pjx__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .pjx__foot { flex-direction: column; gap: 2px; } }
  @media (prefers-reduced-motion: reduce) {
    .pjx[open], .pjx[open] .pjx__item { animation: none; opacity: 1; transform: none; }
  }
</style>
