---
/**
 * Projects: a pinned horizontal gallery (desktop) / native swipe carousel (mobile).
 * Track: intro → drifting photo mosaic → one panel per project → closing CTA.
 * Every project opens a full-screen photo strip (<dialog>). Motion lives in scripts/modules/projects.js.
 */
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import { projects, mosaic } from '../../data/projects.js';

const files = import.meta.glob('../../assets/projects/*/*.jpg', { eager: true });
const photo = (slug, n) => files[`../../assets/projects/${slug}/${String(n).padStart(2, '0')}.jpg`].default;
const photos = (p) => Array.from({ length: p.count }, (_, i) => photo(p.slug, i + 1));
const pad = (n) => String(n).padStart(2, '0');
const total = projects.reduce((a, p) => a + p.count, 0);
---
<section class="pj light" id="projects" aria-label="Selected projects">
  <!-- mobile-only header (desktop shows the intro panel inside the track) -->
  <div class="pj__mhead wrap">
    <div class="sec-head">
      <span class="label">/005 Projects</span>
      <span class="label mute">{projects.length} brands</span>
    </div>
    <h2 class="pj__mtitle display" data-reveal>Selected <span class="serif">projects</span></h2>
  </div>

  <div class="pj__track" tabindex="0" aria-label="Projects, scroll sideways">
    <!-- intro -->
    <div class="pj__panel pj__intro">
      <div class="pj__intro-top">
        <span class="label">/005 Projects</span>
        <span class="label mute">{projects.length} brands · {total} frames</span>
      </div>
      <h2 class="pj__title display">Selected<br /><span class="serif">projects</span></h2>
      <div class="pj__intro-foot">
        <p class="pj__lede mute">Shoots, content and campaigns we’ve produced for brands across food, hospitality, wellness and lifestyle.</p>
        <span class="pj__hint label"><span>Scroll</span><i aria-hidden="true"></i></span>
      </div>
    </div>

    <!-- drifting mosaic -->
    <div class="pj__panel pj__mosaic" aria-hidden="true">
      {mosaic.map((col) => (
        <div class="pj__col">
          {col.map(([slug, n]) => (
            <div class="pj__tile"><Image src={photo(slug, n)} alt="" widths={[240, 480]} sizes="16vw" loading="lazy" /></div>
          ))}
        </div>
      ))}
    </div>

    <!-- one panel per project -->
    {projects.map((p, i) => (
      <article class="pj__panel pj__item" aria-label={p.name}>
        <header class="pj__top">
          <h3 class="pj__name">{p.name}</h3>
        </header>
        <button type="button" class="pj__frame pj__main" data-gallery={`gal-${p.slug}`} aria-label={`Open the ${p.name} gallery`}>
          <Image src={photo(p.slug, p.cover)} alt={`${p.name}: project photo`} widths={[480, 800, 1200, 1600]} sizes="(min-width: 901px) 52vw, 84vw" loading="lazy" style={p.pos && `object-position:${p.pos}`} />
        </button>
        <div class="pj__frame pj__side">
          <Image src={photo(p.slug, p.side)} alt="" widths={[320, 640]} sizes="(min-width: 901px) 18vw, 1px" loading="lazy" style={p.sidePos && `object-position:${p.sidePos}`} />
        </div>
        <footer class="pj__foot">
          <div class="pj__id">
            <span class="pj__idx" aria-hidden="true">/{pad(i + 1)}</span>
            <p class="pj__kind label"><span>{p.kind}</span><span class="mute">{pad(p.count)} photos</span></p>
          </div>
          <button type="button" class="pj__open" data-gallery={`gal-${p.slug}`}>
            <span>View project</span>
            <span class="pj__open-n">({pad(p.count)})</span>
            <span class="pj__plus" aria-hidden="true"></span>
          </button>
        </footer>
      </article>
    ))}

    <!-- closing card -->
    <div class="pj__panel pj__end">
      <span class="label mute">/ Next up</span>
      <p class="pj__end-t display">Your brand<br /><span class="serif">next.</span></p>
      <Button href="#contact" variant="solid">Start a project</Button>
    </div>
  </div>

  <!-- progress (pinned on desktop) -->
  <div class="pj__ui wrap" aria-hidden="true">
    <span class="label">Selected projects</span>
    <span class="pj__bar"><i></i></span>
    <span class="label"><span class="pj__count">01</span> <span class="mute">/ {pad(projects.length)}</span></span>
  </div>

  <!-- galleries -->
  {projects.map((p) => (
    <dialog class="gal" id={`gal-${p.slug}`} aria-label={`${p.name} gallery`} data-lenis-prevent>
      <div class="gal__head wrap">
        <div class="gal__title">
          <span class="label mute">{p.kind}</span>
          <h3 class="gal__name">{p.name}</h3>
        </div>
        <button type="button" class="gal__close" aria-label="Close gallery"><span class="label">Close</span><i aria-hidden="true"></i></button>
      </div>
      <div class="gal__strip">
        {photos(p).map((src, k) => (
          <figure class="gal__fig">
            <Image src={src} alt={`${p.name}, photo ${k + 1} of ${p.count}`} widths={[640, 1000, 1400]} sizes="(min-width: 901px) 60vw, 86vw" loading="lazy" />
            <figcaption class="label mute">{pad(k + 1)}</figcaption>
          </figure>
        ))}
      </div>
      <div class="gal__foot wrap">
        <span class="label"><span class="gal__n">01</span> <span class="mute">/ {pad(p.count)}</span></span>
        <div class="gal__nav">
          <button type="button" class="gal__btn" data-dir="-1" aria-label="Previous photo"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M13 8H3M7 4 3 8l4 4" /></svg></button>
          <button type="button" class="gal__btn" data-dir="1" aria-label="Next photo"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" /></svg></button>
        </div>
      </div>
    </dialog>
  ))}
</section>

<style>
  /* ───────── shared ───────── */
  .pj { position: relative; overflow: hidden; --pad-top: clamp(92px, 12vh, 124px); --pad-bot: clamp(64px, 9vh, 92px); }
  .pj__track { display: flex; align-items: stretch; outline: none; }
  .pj__panel { flex: 0 0 auto; position: relative; }
  .pj :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* intro */
  .pj__intro { display: flex; flex-direction: column; justify-content: space-between; }
  .pj__intro-top, .pj__intro-foot { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s-6); }
  .pj__intro-top { padding-bottom: var(--s-4); border-bottom: 1px solid var(--line-l); }
  .pj__title { font-size: min(12.5vw, 22vh); line-height: .84; letter-spacing: -0.055em; }
  .pj__title .serif { display: inline-block; padding-left: .5em; }
  .pj__lede { max-width: 36ch; font-size: var(--t-md); line-height: 1.45; }
  .pj__hint { display: inline-flex; align-items: center; gap: var(--s-3); white-space: nowrap; }
  .pj__hint i { position: relative; width: 64px; height: 1px; background: currentColor; overflow: hidden; }
  .pj__hint i::after { content: ''; position: absolute; inset: 0; background: var(--paper); transform: translateX(-100%); animation: hint 2.2s var(--ease) infinite; }
  @keyframes hint { 60%, 100% { transform: translateX(100%); } }

  /* mosaic */
  .pj__mosaic { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(8px, .8vw, 14px); align-items: start; }
  .pj__col { display: grid; gap: clamp(8px, .8vw, 14px); will-change: transform; }
  .pj__col:nth-child(even) { margin-top: -28vh; }
  .pj__tile { aspect-ratio: 4 / 5; overflow: hidden; border-radius: calc(var(--radius) * .6); background: var(--paper-2); }

  /* project panel */
  .pj__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(150px, 17vw, 310px);
    grid-template-rows: auto minmax(0, 1fr) auto;
    grid-template-areas: 'top top' 'main side' 'foot foot';
    column-gap: clamp(14px, 1.4vw, 24px);
  }
  .pj__top { grid-area: top; display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s-5); padding-bottom: clamp(12px, 1.6vh, 20px); }
  .pj__name {
    margin: 0; font-family: var(--f-display); font-weight: 400; font-variation-settings: 'wdth' 100;
    font-size: min(6.4vw, 11vh); line-height: .86; letter-spacing: -0.05em; text-transform: uppercase;
    text-wrap: balance;
  }
  .pj__id { display: flex; align-items: flex-end; gap: clamp(16px, 2vw, 32px); }
  .pj__kind { display: grid; gap: 2px; margin: 0; white-space: nowrap; padding-bottom: .15em; }

  .pj__frame { position: relative; overflow: hidden; border-radius: var(--radius); background: var(--paper-2); }
  .pj__main { grid-area: main; padding: 0; border: 0; cursor: pointer; display: block; width: 100%; height: 100%; }
  .pj__main :global(img) { width: 112%; max-width: none; margin-left: -6%; transition: scale 1.2s var(--ease); }
  .pj__side { grid-area: side; align-self: end; height: 64%; }
  .pj__main::after {
    content: 'View'; position: absolute; left: 50%; top: 50%; translate: -50% -50%; scale: .6; opacity: 0;
    display: grid; place-items: center; width: 104px; aspect-ratio: 1; border-radius: 50%;
    background: var(--white); color: var(--ink); font: 500 var(--t-sm)/1 var(--f-body);
    transition: scale .6s var(--ease), opacity .4s var(--ease);
  }
  @media (hover: hover) {
    .pj__main:hover :global(img) { scale: 1.04; }
    .pj__main:hover::after { scale: 1; opacity: 1; }
  }
  .pj__main:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }

  .pj__foot { grid-area: foot; display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s-5); padding-top: clamp(10px, 1.4vh, 18px); }
  .pj__idx { font-family: var(--f-display); font-weight: 300; font-size: min(5.2vw, 9vh); line-height: .8; letter-spacing: -0.05em; }
  .pj__open {
    display: inline-flex; align-items: center; gap: var(--s-2); height: 46px; padding: 0 var(--s-3) 0 var(--s-5);
    border: 1px solid var(--line-l); border-radius: 999px; font: 500 var(--t-sm)/1 var(--f-body); color: inherit; background: none; cursor: pointer; white-space: nowrap;
    transition: background-color .4s var(--ease), color .4s var(--ease), border-color .4s var(--ease);
  }
  .pj__open-n { font-family: var(--f-mono); font-size: var(--t-xs); opacity: .6; }
  .pj__plus { position: relative; width: 30px; height: 30px; border-radius: 50%; background: var(--ink); margin-left: var(--s-2); }
  .pj__plus::before, .pj__plus::after { content: ''; position: absolute; left: 50%; top: 50%; width: 10px; height: 1.5px; background: var(--paper); translate: -50% -50%; transition: rotate .5s var(--ease); }
  .pj__plus::after { rotate: 90deg; }
  @media (hover: hover) {
    .pj__open:hover { background: var(--ink); color: var(--paper); border-color: var(--ink); }
    .pj__open:hover .pj__plus { background: var(--paper); }
    .pj__open:hover .pj__plus::before, .pj__open:hover .pj__plus::after { background: var(--ink); rotate: 90deg; }
    .pj__open:hover .pj__plus::after { rotate: 180deg; }
  }

  /* closing card */
  .pj__end { display: flex; flex-direction: column; justify-content: space-between; align-items: flex-start; background: var(--ink); color: var(--white); }
  .pj__end-t { font-size: min(11vw, 20vh); line-height: .84; letter-spacing: -0.055em; margin: auto 0 var(--s-7); }
  .pj__end .mute { color: var(--mute-d); }

  /* progress */
  .pj__ui { display: flex; align-items: center; gap: var(--s-5); }
  .pj__bar { flex: 1; height: 1px; background: var(--line-l); overflow: hidden; }
  .pj__bar i { display: block; height: 100%; background: var(--ink); transform: scaleX(0); transform-origin: left; }

  /* ───────── desktop: pinned horizontal track ───────── */
  @media (min-width: 901px) {
    .pj__mhead { display: none; }
    .pj { height: 100vh; height: 100svh; }
    .pj__track { height: 100%; gap: clamp(64px, 6vw, 120px); padding-left: var(--gutter); will-change: transform; }
    .pj__panel { height: 100%; padding-block: var(--pad-top) var(--pad-bot); }
    .pj__intro { width: min(60vw, 1100px); }
    .pj__mosaic { width: min(62vw, 1080px); padding-block: 0; overflow: hidden; }
    .pj__item { width: min(70vw, 1280px); }
    .pj__end { width: min(64vw, 1100px); padding: var(--pad-top) clamp(32px, 4vw, 72px) var(--pad-bot); }
    .pj__ui { position: absolute; left: 0; right: 0; bottom: clamp(20px, 3.4vh, 34px); z-index: 2; pointer-events: none; mix-blend-mode: difference; color: var(--white); }
    .pj__ui .mute { color: rgba(251,250,247,.6); }
    .pj__ui .pj__bar { background: rgba(251,250,247,.25); }
    .pj__ui .pj__bar i { background: var(--white); }
  }
  /* reduced motion on desktop: plain sideways scroller */
  @media (min-width: 901px) and (prefers-reduced-motion: reduce) {
    .pj__track { overflow-x: auto; padding-right: var(--gutter); }
  }

  /* ───────── mobile / tablet: native swipe carousel ───────── */
  @media (max-width: 900px) {
    .pj { padding-block: var(--section-y); }
    .pj__mtitle { font-size: var(--t-2xl); margin: var(--s-5) 0 var(--s-7); }
    .pj__intro, .pj__mosaic { display: none; }
    .pj__track {
      gap: 12px; overflow-x: auto; overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory; scroll-padding-inline: var(--gutter);
      padding-inline: var(--gutter); scrollbar-width: none;
    }
    .pj__track::-webkit-scrollbar { display: none; }
    .pj__panel { scroll-snap-align: start; width: min(84vw, 520px); }
    .pj__item {
      grid-template-columns: minmax(0, 1fr); grid-template-areas: 'top' 'main' 'foot'; grid-template-rows: auto auto auto;
    }
    .pj__kind { gap: 0; }
    .pj__name { font-size: clamp(2.1rem, 9.4vw, 3.4rem); min-height: 1.72em; display: flex; align-items: flex-end; }
    .pj__main { aspect-ratio: 4 / 5; height: auto; }
    .pj__main::after { display: none; }
    .pj__side { display: none; }
    .pj__foot { align-items: center; }
    .pj__id { gap: var(--s-3); align-items: center; }
    .pj__idx { font-size: 2.2rem; }
    .pj__open { padding-left: var(--s-4); }
    .pj__open-n { display: none; }
    .pj__end { border-radius: var(--radius); padding: var(--s-6); min-height: 100%; }
    .pj__end-t { font-size: clamp(3rem, 15vw, 5rem); }
    .pj__ui { margin-top: var(--s-6); }
  }

  /* ───────── gallery dialog ───────── */
  .gal {
    position: fixed; inset: 0; width: 100%; height: 100%; max-width: none; max-height: none; margin: 0; padding: 0; border: 0;
    display: none; flex-direction: column; justify-content: space-between;
    background: var(--ink); color: var(--white); overscroll-behavior: contain;
  }
  .gal[open] { display: flex; animation: gal-in .7s var(--ease); }
  .gal::backdrop { background: var(--ink); }
  @keyframes gal-in { from { opacity: 0; clip-path: inset(8% 0 8% 0); } }
  .gal__head, .gal__foot { display: flex; justify-content: space-between; align-items: center; gap: var(--s-5); }
  .gal__head { padding-top: var(--s-5); }
  .gal__foot { padding-bottom: var(--s-5); }
  .gal__title { display: grid; gap: var(--s-1); }
  .gal__name { margin: 0; font-family: var(--f-display); font-weight: 400; font-size: clamp(1.6rem, 3.4vw, 3rem); line-height: .9; letter-spacing: -0.045em; text-transform: uppercase; }
  .gal__close {
    display: inline-flex; align-items: center; gap: var(--s-3); height: 46px; padding: 0 var(--s-4) 0 var(--s-5);
    border: 1px solid rgba(251,250,247,.3); border-radius: 999px; background: none; color: inherit; cursor: pointer;
    transition: background-color .4s var(--ease), color .4s var(--ease);
  }
  .gal__close i { position: relative; width: 14px; height: 14px; }
  .gal__close i::before, .gal__close i::after { content: ''; position: absolute; left: 0; right: 0; top: 50%; height: 1.5px; background: currentColor; rotate: 45deg; }
  .gal__close i::after { rotate: -45deg; }
  .gal__close:hover { background: var(--white); color: var(--ink); }

  .gal__strip {
    display: flex; align-items: center; gap: clamp(10px, 1vw, 16px);
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    padding-inline: max(var(--gutter), calc((100vw - 60vw) / 2));
    scroll-padding-inline: max(var(--gutter), calc((100vw - 60vw) / 2));
  }
  .gal__strip::-webkit-scrollbar { display: none; }
  .gal__fig { flex: 0 0 auto; margin: 0; scroll-snap-align: center; display: grid; gap: var(--s-2); }
  .gal__fig :global(img) { width: auto; height: min(70vh, 70svh); max-width: 86vw; object-fit: cover; border-radius: calc(var(--radius) * .7); background: var(--ink-3); }
  .gal__nav { display: flex; gap: var(--s-2); }
  .gal__btn {
    display: grid; place-items: center; width: 52px; aspect-ratio: 1; border-radius: 50%;
    border: 1px solid rgba(251,250,247,.3); background: none; color: inherit; cursor: pointer;
    transition: background-color .4s var(--ease), color .4s var(--ease);
  }
  .gal__btn svg { width: 16px; height: 16px; }
  .gal__btn:hover { background: var(--white); color: var(--ink); }
  .gal__btn:disabled { opacity: .3; pointer-events: none; }
  @media (max-width: 600px) {
    .gal__strip { padding-inline: 7vw; scroll-padding-inline: 7vw; }
    .gal__fig :global(img) { height: auto; max-height: 66svh; width: 86vw; object-fit: contain; background: none; }
  }
</style>
