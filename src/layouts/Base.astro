---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import { socials } from '../data/site.js';

const {
  title = 'Attitude Design Studio | Creative & Digital Marketing Agency',
  description = 'Attitude Design Studio is a creative and digital marketing agency, established in 2019, helping brands grow through strategic marketing, distinctive branding, social media management and creative content production.',
} = Astro.props;
const favicon = '/favicon.svg';

// Search & sharing: one official address, a preview image (public/og.jpg, built by tools/make-social.mjs),
// and business info Google can read (schema.org Organization + WebSite).
const site = Astro.site.href; // https://attitudedesignstudio.org/
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL('/og.jpg', site).href;
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site}#organization`,
  name: 'Attitude Design Studio',
  alternateName: 'Attitude Creatives Design Studio',
  url: site,
  logo: new URL('/logo.png', site).href,
  image: ogImage,
  description,
  foundingDate: '2019',
  sameAs: socials.map((s) => s.href),
};
const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Attitude Design Studio',
  url: site,
  publisher: { '@id': org['@id'] },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#0c0c0b" />

    <meta property="og:site_name" content="Attitude Design Studio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_PH" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Attitude Design Studio, creative and digital marketing agency, with photos from client shoots" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={favicon} type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/logo.png" />
    <script type="application/ld+json" set:html={JSON.stringify([org, website])} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <slot />
    <div class="grain" aria-hidden="true"></div>
  </body>
</html>
